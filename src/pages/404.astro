---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found" description="The requested page could not be found.">
  <article>
    <h1 class="page-title">Nothing here</h1>
    <div class="post-content">
      <p>The page may have moved, or the link may be older than this version of the site.</p>
      <p><a href="/">Return to the home page</a> or <a href="/search/">search the archive</a>.</p>
    </div>
  </article>
</SiteLayout>
