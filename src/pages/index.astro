---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { paginate, published, sortPosts } from '../lib/blog';

const posts = sortPosts((await getCollection('blog')).filter(published));
const pages = paginate(posts);
---

<SiteLayout>
  <h1 class="screen-reader-text">Latest posts</h1>
  <PostList posts={pages[0] ?? []} totalPages={pages.length} />
</SiteLayout>
