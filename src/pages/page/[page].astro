---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { paginate, published, sortPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = sortPosts((await getCollection('blog')).filter(published));
  const pages = paginate(posts);

  return pages.slice(1).map((posts, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        posts,
        page,
        totalPages: pages.length,
      },
    };
  });
}

const { posts, page, totalPages } = Astro.props;
---

<SiteLayout title={`Page ${page}`}>
  <PostList posts={posts} heading={`Posts · Page ${page}`} currentPage={page} totalPages={totalPages} />
</SiteLayout>
