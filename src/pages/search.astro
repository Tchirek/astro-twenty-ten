---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { postPath, published, sortPosts } from '../lib/blog';

const posts = sortPosts((await getCollection('blog')).filter(published));
// ponytail: client-side full-text index; replace with Pagefind when corpus size or ranking quality becomes a measured problem.
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  url: postPath(post),
  date: post.data.date.toISOString(),
  haystack: [post.data.title, post.data.description, ...post.data.categories, ...post.data.tags, post.body ?? '']
    .join(' ')
    .toLocaleLowerCase(),
}));
const serializedIndex = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<SiteLayout title="Search" description="Search every published post.">
  <section class="search-page">
    <h1 class="page-title">Search</h1>
    <form id="search-page-form" role="search">
      <label class="screen-reader-text" for="search-query">Search every post</label>
      <input id="search-query" data-site-search name="q" type="search" placeholder="Search Twenty Ten Notes..." autocomplete="off" />
      <button type="submit">Search</button>
    </form>
    <p id="search-status" role="status">Enter a word or phrase.</p>
    <ul id="search-results" class="search-results"></ul>
    <script is:inline id="search-index" type="application/json" set:html={serializedIndex}></script>
  </section>

  <script>
    interface SearchEntry {
      title: string;
      description: string;
      url: string;
      date: string;
      haystack: string;
    }

    const form = document.querySelector<HTMLFormElement>('#search-page-form');
    const input = document.querySelector<HTMLInputElement>('#search-query');
    const list = document.querySelector<HTMLUListElement>('#search-results');
    const status = document.querySelector<HTMLElement>('#search-status');
    const data = document.querySelector<HTMLScriptElement>('#search-index');
    const entries: SearchEntry[] = JSON.parse(data?.textContent ?? '[]');

    function renderResults(query: string) {
      if (!list || !status) return;
      const terms = query.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
      const matches = terms.length ? entries.filter((entry) => terms.every((term) => entry.haystack.includes(term))) : [];
      list.replaceChildren(...matches.map((entry) => {
        const item = document.createElement('li');
        const heading = document.createElement('h2');
        const link = document.createElement('a');
        const excerpt = document.createElement('p');
        link.href = entry.url;
        link.textContent = entry.title;
        excerpt.textContent = entry.description;
        heading.append(link);
        item.append(heading, excerpt);
        return item;
      }));
      status.textContent = terms.length ? `${matches.length} result${matches.length === 1 ? '' : 's'} for “${query.trim()}”.` : 'Enter a word or phrase.';
    }

    function runSearch() {
      const query = input?.value ?? '';
      const url = new URL(location.href);
      if (query.trim()) url.searchParams.set('q', query.trim());
      else url.searchParams.delete('q');
      history.replaceState({}, '', url);
      renderResults(query);
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      runSearch();
    });

    if (input) {
      input.value = new URLSearchParams(location.search).get('q') ?? '';
      renderResults(input.value);
      if (new URLSearchParams(location.search).has('focus')) input.focus();
    }
  </script>
</SiteLayout>
