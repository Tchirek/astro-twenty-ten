---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { postPath, published, sortPosts } from '../lib/blog';
import { buildSearchIndex } from '../lib/search';

const posts = sortPosts((await getCollection('blog')).filter(published));
// ponytail: the full index ships with the page; split it into a static asset if the corpus makes this page measurably heavy.
const searchIndex = buildSearchIndex(posts.map((post) => ({
  title: post.data.title,
  tags: post.data.tags,
  description: post.data.description,
  url: postPath(post),
  date: post.data.date.toISOString(),
  body: post.body ?? '',
})));
const serializedIndex = JSON.stringify(searchIndex).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---

<SiteLayout title="Search" description="Search every published post.">
  <section class="search-page">
    <h1 class="page-title">Search</h1>
    <form id="search-page-form" action="/search/" method="get" role="search">
      <label class="screen-reader-text" for="search-query">Search every post</label>
      <input id="search-query" data-site-search name="q" type="search" placeholder="Search Twenty Ten Notes..." autocomplete="off" />
      <button type="submit">Search</button>
    </form>
    <p id="search-status" role="status">Enter a word or phrase.</p>
    <ul id="search-results" class="search-results"></ul>
    <noscript><p>Instant search needs modern JavaScript. Browse the <a href="/archives/">archives</a>, categories, or tags in the sidebar.</p></noscript>
    <script is:inline id="search-index" type="application/json" set:html={serializedIndex}></script>
  </section>

  <script>
    import { querySearch, type SearchIndex } from '../lib/search';

    const form = document.querySelector<HTMLFormElement>('#search-page-form');
    const input = document.querySelector<HTMLInputElement>('#search-query');
    const list = document.querySelector<HTMLUListElement>('#search-results');
    const status = document.querySelector<HTMLElement>('#search-status');
    const data = document.querySelector<HTMLScriptElement>('#search-index');
    const index: SearchIndex = JSON.parse(data?.textContent ?? '{"documents":[],"postings":{}}');

    function renderResults(query: string) {
      if (!list || !status) return;
      const matches = querySearch(index, query);
        list.replaceChildren(...matches.map((entry) => {
          const item = document.createElement('li');
          const heading = document.createElement('h2');
          const link = document.createElement('a');
          const excerpt = document.createElement('p');
          link.href = entry.url;
          link.textContent = entry.title;
          excerpt.textContent = entry.description;
          if (entry.snippet) excerpt.textContent = entry.snippet;
          heading.append(link);
          item.append(heading, excerpt);
          return item;
        }));
      status.textContent = query.trim() ? `${matches.length} result${matches.length === 1 ? '' : 's'} for “${query.trim()}”.` : 'Enter a word or phrase.';
    }

    function runSearch() {
      const query = input?.value ?? '';
      const url = new URL(location.href);
      if (query.trim()) url.searchParams.set('q', query.trim());
      else url.searchParams.delete('q');
      history.replaceState(history.state, '', url);
      renderResults(query);
    }

    if (form) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        runSearch();
      });
    }

    if (input) {
      input.value = new URLSearchParams(location.search).get('q') ?? '';
      input.addEventListener('input', runSearch);
      renderResults(input.value);
      if (new URLSearchParams(location.search).has('focus')) input.focus();
    }
  </script>
</SiteLayout>
