---
import { getImage } from 'astro:assets';
import headerSource from '../assets/header-demo.png';
import BaseHead from '../components/BaseHead.astro';
import BrowserEnhancements from '../components/BrowserEnhancements.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';
import siteConfig from '../../site.config.ts';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  noSidebar?: boolean;
}

const header = await getImage({
  src: headerSource,
  width: 940,
  height: 198,
  fit: 'cover',
  position: 'center',
  format: 'webp',
  priority: true,
  alt: '',
});

const { noSidebar = false, ...headProps } = Astro.props;
const path = Astro.url.pathname;
const activePath = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <BaseHead {...headProps} headerImage={header.src} />
    <BrowserEnhancements />
  </head>
  <body id="top">
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="branding">
          <a class="site-title" href="/">{siteConfig.title}</a>
          <p class="site-description">{siteConfig.description}</p>
        </div>
        <img
          src={header.src}
          {...header.attributes}
          class="header-art"
          transition:persist="header-art"
        />
        <nav class="primary-nav" aria-label="Primary navigation">
          <div class="nav-links">
            {siteConfig.navigation.map((item) => (
              <a href={item.href} aria-current={activePath(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
          <div class="nav-tools">
            {siteConfig.appearance.darkMode && <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">☾</button>}
          </div>
        </nav>
      </header>

      <div class:list={['page-grid', { 'page-grid--wide': noSidebar }]}>
        <main id="content">
          <slot />
        </main>

        {!noSidebar && <Sidebar />}
      </div>

      <footer class="site-footer">
        <p><a href="/">{siteConfig.title}</a></p>
        <p>{siteConfig.footer.prefix} <a href={siteConfig.footer.href}>{siteConfig.footer.label}</a>.</p>
      </footer>
    </div>
  </body>
</html>
