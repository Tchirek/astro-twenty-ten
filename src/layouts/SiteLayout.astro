---
import { getImage } from 'astro:assets';
import headerSource from '../assets/header-demo.png';
import BaseHead from '../components/BaseHead.astro';
import BrowserEnhancements from '../components/BrowserEnhancements.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  noSidebar?: boolean;
}

const header = await getImage({
  src: headerSource,
  width: 940,
  height: 198,
  fit: 'cover',
  position: 'center',
  format: 'webp',
  priority: true,
  alt: '',
});

const { noSidebar = false, ...headProps } = Astro.props;
const siteName = 'Twenty Ten Notes';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <BaseHead {...headProps} siteName={siteName} headerImage={header.src} />
    <BrowserEnhancements />
  </head>
  <body id="top">
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="branding">
          <a class="site-title" href="/">{siteName}</a>
          <p class="site-description">Notes, links, and small experiments.</p>
        </div>
        <img
          src={header.src}
          {...header.attributes}
          class="header-art"
          transition:persist="header-art"
        />
        <nav class="primary-nav" aria-label="Primary navigation">
          <div class="nav-links">
            <a href="/" aria-current={path === '/' ? 'page' : undefined}>主頁</a>
            <a href="/about/" aria-current={path === '/about' ? 'page' : undefined}>About Me</a>
            <a href="/archives/" aria-current={path.startsWith('/archives') ? 'page' : undefined}>Archives</a>
          </div>
          <div class="nav-tools">
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">☾</button>
          </div>
        </nav>
      </header>

      <div class:list={['page-grid', { 'page-grid--wide': noSidebar }]}>
        <main id="content">
          <slot />
        </main>

        {!noSidebar && <Sidebar />}
      </div>

      <footer class="site-footer">
        <p><a href="/">{siteName}</a></p>
        <p>Proudly powered by <a href="https://astro.build/">Astro</a>.</p>
      </footer>
    </div>
  </body>
</html>
