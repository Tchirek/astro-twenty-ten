---
import { getImage } from 'astro:assets';
import headerSource from '../assets/header-demo.png';
import BaseHead from '../components/BaseHead.astro';
import BrowserEnhancements from '../components/BrowserEnhancements.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';
import siteConfig from '../../site.config.ts';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  author?: string;
  publishedTime?: Date;
  updatedTime?: Date;
  noSidebar?: boolean;
}

const [header, headerFallback] = await Promise.all([
  getImage({
    src: headerSource,
    width: 940,
    height: 198,
    fit: 'cover',
    position: 'center',
    format: 'webp',
    priority: true,
    alt: '',
  }),
  getImage({
    src: headerSource,
    width: 940,
    height: 198,
    fit: 'cover',
    position: 'center',
    format: 'png',
    priority: true,
    alt: '',
  }),
]);

const { noSidebar = false, ...headProps } = Astro.props;
const path = Astro.url.pathname;
const activePath = (href: string) => href === '/' ? path === '/' : path === href || path.startsWith(`${href.replace(/\/+$/, '')}/`);
const legacyHtml5Shim = `<!--[if lt IE 9]><script>(function(d){var e='article aside footer header main nav picture section time'.split(' '),i=e.length;while(i--){d.createElement(e[i]);}}(document));</script><![endif]-->`;
---

<!doctype html>
<html lang={siteConfig.language} data-dark-mode={siteConfig.appearance.darkMode ? '' : undefined}>
  <head>
    <BaseHead {...headProps} headerImage={header.src} />
    <Fragment set:html={legacyHtml5Shim} />
    <BrowserEnhancements />
  </head>
  <body
    id="top"
    data-code-copy={siteConfig.features.codeCopy ? '' : undefined}
    data-search-shortcut={siteConfig.features.search ? '' : undefined}
  >
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="branding">
          <a class="site-title" href="/">{siteConfig.title}</a>
          <p class="site-description">{siteConfig.description}</p>
        </div>
        <picture class="header-picture">
          <source srcset={header.src} type="image/webp" />
          <img
            src={headerFallback.src}
            {...headerFallback.attributes}
            class="header-art"
            alt=""
          />
        </picture>
        <nav class="primary-nav" aria-label="Primary navigation">
          <div class="nav-links">
            {siteConfig.navigation.map((item) => (
              <a href={item.href} aria-current={activePath(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
          <div class="nav-tools">
            {siteConfig.appearance.darkMode && <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">☾</button>}
          </div>
        </nav>
      </header>

      <div class:list={['page-grid', { 'page-grid--wide': noSidebar }]}>
        <main id="content">
          <slot />
        </main>

        {!noSidebar && <Sidebar />}
      </div>

      <footer class="site-footer">
        <p class="footer-credit">{siteConfig.footer.prefix} <a class="external-link" href={siteConfig.footer.href} target="_blank" rel="license external noopener">{siteConfig.footer.label}<span class="external-link-mark" aria-hidden="true">↗</span><span class="screen-reader-text"> (opens in a new tab)</span></a></p>
      </footer>
    </div>
  </body>
</html>
