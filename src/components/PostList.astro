---
import type { BlogPost } from '../lib/blog';
import PostSummary from './PostSummary.astro';

interface Props {
  posts: BlogPost[];
  heading?: string;
  currentPage?: number;
  totalPages?: number;
}

const { posts, heading, currentPage = 1, totalPages = 1 } = Astro.props;
const newer = currentPage > 2 ? `/page/${currentPage - 1}/` : '/';
const older = currentPage < totalPages ? `/page/${currentPage + 1}/` : undefined;
---

{heading && <h1 class="page-title">{heading}</h1>}
{posts.length > 0 ? posts.map((post) => <PostSummary post={post} />) : <p>No posts found.</p>}
{totalPages > 1 && (
  <nav class="pagination" aria-label="Post pages">
    {currentPage > 1 && <a href={newer}>← Newer Posts</a>}
    {older && <a href={older}>Older Posts →</a>}
  </nav>
)}
