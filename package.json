{
  "name": "astro-twenty-ten",
  "version": "0.1.0",
  "description": "A static Astro recreation of the classic WordPress Twenty Ten blog theme.",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && npm --prefix services/sicsic-comment-ui run check",
    "lint": "eslint .",
    "preview": "astro preview",
    "comments:build": "npm --prefix services/sicsic-comment-ui run build",
    "test": "node --test services/sicsic-comment-ui/test/api.test.mjs services/sicsic-comment-ui/test/config.test.mjs src/lib/blog.test.ts src/lib/og.test.ts src/lib/rehype-twenty-ten.test.ts src/lib/search.test.ts",
    "test:routes": "node --test tests/routes.test.mjs tests/legacy-baseline.test.mjs",
    "test:budget": "node --test services/sicsic-comment-ui/test/bundle.test.mjs tests/bundle-budget.test.mjs",
    "test:e2e": "playwright test tests/modern.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/visual.spec.ts --project=chromium --update-snapshots"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "1.7.0",
    "globals": "16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
