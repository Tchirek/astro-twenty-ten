{
  "name": "astro-twenty-ten",
  "version": "0.1.0",
  "description": "A static Astro recreation of the classic WordPress Twenty Ten blog theme.",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "lint": "astro check",
    "preview": "astro preview",
    "test": "node --test src/lib/blog.test.ts src/lib/og.test.ts src/lib/rehype-twenty-ten.test.ts src/lib/search.test.ts",
    "test:routes": "node --test tests/routes.test.mjs tests/legacy-baseline.test.mjs",
    "test:e2e": "playwright test tests/modern.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/visual.spec.ts --project=chromium --update-snapshots"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "typescript": "^6.0.3"
  }
}
